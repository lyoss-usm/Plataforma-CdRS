DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_SITE_URL=http://localhost:5173

# Proxy BGG (#8). Sin token, usa BGG_MOCK=1 (lee fixtures/bgg/, ver README).
BGG_API_TOKEN=
BGG_MOCK=1
# Simula una caída de BGG (solo con BGG_MOCK=1): timeout | 429 | 503
BGG_MOCK_FALLA=
# Validez de la caché de fichas: <n>(m|h|d)
BGG_CACHE_TTL=30d
