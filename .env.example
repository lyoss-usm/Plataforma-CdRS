# Variables de entorno: tipos y significado en README § Variables de entorno.
# Las PUBLIC_* llegan al navegador; el resto solo existe en el servidor y los scripts.

# --- Configuración ---
# Conexión directa a Postgres (seed y pruebas; la app no la usa).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Supabase: URL y claves de `pnpm exec supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Solo servidor (envío de invitaciones del staff). Nunca con prefijo PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Dominio público sin `/` final, para las imágenes al compartir el link.
PUBLIC_SITE_URL=http://localhost:5173
# Token de la API de BoardGameGeek (#8). Sin token ni mock, el proxy responde 503.
BGG_API_TOKEN=

# --- Mocks (desarrollo y pruebas; en producción van en 0 o vacíos) ---
# 1: el proxy BGG lee fixtures/bgg/ en vez de llamar a BGG.
BGG_MOCK=1
# Simula una caída de BGG (solo con BGG_MOCK=1): timeout | 429 | 503
BGG_MOCK_FALLA=

# --- Feature flags (#40): 1 encendido, 0 apagado; si falta, queda encendido ---
PUBLIC_FLAG_CATALOGO=1
PUBLIC_FLAG_FORMULARIO=1
PUBLIC_FLAG_SOLICITUDES=1
PUBLIC_FLAG_INVENTARIO=1
PUBLIC_FLAG_MODERACION=1
PUBLIC_FLAG_BGG=1
